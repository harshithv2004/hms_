# Database Configuration (PostgreSQL / Neon)
# Replace with your actual Neon PostgreSQL connection string:
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Secret Key
SECRET_KEY=generate-a-strong-random-key-for-production

# Port for local Flask server (default: 5000)
PORT=5000

# Frontend environment variable (if running frontend separately without proxy)
# VITE_API_URL=http://127.0.0.1:5000
